# ==============================================================================
# SMART WATER USAGE MONITORING & AUTOMATED BILLING MANAGEMENT PLATFORM
# Team: Code_Crew | Infosys Springboard Project
# Environment Variables Template
#
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#    cp .env.example .env (or copy in PowerShell: Copy-Item .env.example .env)
# 2. Fill in your real local credentials in the newly created '.env'.
# 3. NEVER commit your '.env' file or actual secrets to version control.
# ==============================================================================

# Application Profile & Server Port
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartwater_db
DB_USERNAME=smartwater_user
DB_PASSWORD=YOUR_LOCAL_POSTGRES_PASSWORD_HERE

# JWT Authentication
# REQUIRED: Generate a strong base64-encoded 256-bit+ HMAC secret key.
# Linux / macOS:
#   openssl rand -base64 32
# Windows PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
# Do NOT use a hardcoded or static key in production or dev profiles.
JWT_SECRET=GENERATE_AND_PASTE_YOUR_256BIT_BASE64_SECRET_HERE
JWT_EXPIRATION_MS=86400000

# Transactional Email Server Configuration (MailHog for local dev, or external SMTP)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@smartwater.local

# Frontend Client Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
